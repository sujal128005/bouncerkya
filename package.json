    "db:setup": "npm run prisma:generate && npm run db:migrate && npm run db:seed",
    "db:reset": "tsx scripts/db-reset.ts && npm run db:setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:check": "tsx scripts/engine-check.ts",
    "agent:run": "tsx scripts/agent-run.ts",
    "eval": "tsx eval/run.ts",
    "eval:credentials": "tsx eval/credentials/run.ts",
    "eval:semantic": "tsx eval/semantic/run.ts",
    "razorpay:verify": "tsx scripts/razorpay-verify.ts",
    "privacy:keygen": "tsx scripts/privacy-keygen.ts",
    "privacy:audit": "tsx scripts/privacy-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
