# Local SQLite database used by Prisma and by the Next.js server.
# Path is resolved from the project root.
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Intent-Cart Consistency Engine (Prompt 3)
#
# The engine talks to a model through a narrow port, so the backend is an env
# var rather than a code change. Configure ONE of the two blocks below.
# Without either, the engine is not called at all: `npm run db:seed` falls back
# to clearly-labelled placeholder diffs and the console says so on screen.
# ---------------------------------------------------------------------------

# --- Option A: Anthropic (the intended backend) ---
# Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional; defaults to claude-sonnet-5.
# STEALTH_ENGINE_MODEL="claude-sonnet-5"

# --- Option B: any OpenAI-compatible endpoint (free tiers) ---
# Presets: groq | xai | openrouter | gemini
# STEALTH_ENGINE_PRESET="groq"
# STEALTH_ENGINE_API_KEY=""
# Optional; each preset has a sensible default model.
# STEALTH_ENGINE_MODEL="openai/gpt-oss-120b"
#
# Or point at anything else yourself (a local llama.cpp server, say):
# STEALTH_ENGINE_BASE_URL="http://localhost:8080/v1"
# STEALTH_ENGINE_MODEL="your-model"
# STEALTH_ENGINE_API_KEY="not-needed-but-required"

# ---------------------------------------------------------------------------
# Razorpay (Prompt 5) — TEST MODE ONLY.
#
# Keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# in Test Mode. The key id must start with rzp_test_; the client refuses any
# other prefix, because an ALLOW decision creates a real order.
# Without these, an ALLOW records the decision and reports that no order could
# be created — it never pretends one was.
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET=""
# Only needed to receive webhooks (payment.captured / payment.failed).
# RAZORPAY_WEBHOOK_SECRET=""

# Demo agent model override. Defaults to claude-haiku-4-5-20251001 on
# Anthropic, or the configured engine model on an OpenAI-compatible backend.
# STEALTH_AGENT_MODEL=""

# ---------------------------------------------------------------------------
# Field encryption at rest — REQUIRED.
#
# Four columns are stored as AES-256-GCM ciphertext, bound to their row and
# column so a ciphertext cannot be moved between rows: the principal's display
# name, every cart line name, and the session's free text and structured
# fields. Without this key the app cannot read or write them and will refuse
# to start rather than fall back to plaintext.
#
# Generate one:   npm run privacy:keygen
#
# Rotating it makes every existing encrypted row unreadable. For the seeded
# demo database the recovery is `npm run db:reset` with the dev server stopped.
# ---------------------------------------------------------------------------
STEALTH_ENCRYPTION_KEY=""
