+    <tr><td>Sun / moon icon</td><td>far right</td><td>Light and dark toggle. Choice is remembered across reloads. Leave it on dark for recording.</td></tr>
+  </table>
+</div>
+
+<div class="map">
+  <h3>Overview</h3>
