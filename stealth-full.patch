+  /* System-light viewers, unless they explicitly asked for dark. */
+  @media (prefers-color-scheme: light) {
+    :root:not([data-theme="dark"]) {
+      --canvas: #f5f5f4;
+      --surface: #ffffff;
+      --inset: #fafaf9;
+      --line: #e3e3e1;
